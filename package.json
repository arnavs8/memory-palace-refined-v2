{
  "name": "memory-palace-refined-v2",
  "productName": "Memory Palace",
  "version": "2.1.1",
  "description": "A private desktop space for learning through spatial memory",
  "author": "arnavs8",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --win nsis portable",
    "test": "node --experimental-strip-types --test tests/core.test.ts tests/layout.test.ts tests/analysis.test.cjs tests/completion.test.cjs",
    "test:e2e": "playwright test",
    "assets": "node scripts/download-assets.mjs",
    "test:desktop": "node scripts/electron-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/three": "^0.181.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "idb": "^8.0.3",
    "lucide": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.10.1",
    "three": "^0.181.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "build": {
    "appId": "com.arnavs8.memorypalace",
    "productName": "Memory Palace",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "useZip": true,
      "differentialPackage": false
    },
    "portable": {
      "useZip": true
    }
  }
}
